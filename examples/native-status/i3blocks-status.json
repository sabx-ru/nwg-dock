{
  "enabled": true,
  "intellihide": true,
  "width": 56,
  "bottom_margin": 0,
  "rows": [
    [
      "power"
    ],
    [
      "time"
    ]
  ],
  "items": {
    "gswitch": {
      "command": "\"$HOME/.config/i3blocks/gswitch\"",
      "interval": 2
    },
    "vpn": {
      "command": "\"$HOME/.config/i3blocks/vpn\"",
      "interval": 0
    },
    "bluetooth": {
      "command": "\"$HOME/.config/i3blocks/bluetooth\"",
      "interval": 5
    },
    "wifi": {
      "command": "\"$HOME/.config/i3blocks/wifi\"",
      "interval": 5
    },
    "power": {
      "command": "\"$HOME/.local/libexec/nwg-power-backend\"",
      "interval": 5,
      "markup": false,
      "percentage_only": true
    },
    "time": {
      "command": "date '+%H:%M'",
      "interval": 5,
      "color": "#cad3f5"
    },
    "date": {
      "command": "date '+%d.%m'",
      "interval": 30,
      "color": "#cad3f5"
    }
  },
  "match_dock_width": true,
  "expanded_rows": [
    [
      "gswitch"
    ],
    [
      "vpn"
    ],
    [
      "bluetooth"
    ],
    [
      "wifi"
    ]
  ]
}
